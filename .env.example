# Copy to .env. Leave keys empty to run fully offline (fallback implementations).
# Comments must be on their own line.

# simulated | elevenlabs
STT_ADAPTER=simulated
# rules | llm
QUERY_PARSER=rules
# hashing | jina
TEXT_ENCODER=hashing
# color_histogram | jina_clip
IMAGE_ENCODER=color_histogram
# token_coverage | jina | none
RERANKER=token_coverage

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=

# Any OpenAI-compatible chat endpoint (Gemini, OpenAI, DeepSeek, Groq, ...)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=2.5

JINA_API_KEY=
